{
  "name": "llmdouble",
  "version": "0.1.0",
  "description": "An HTTP server that impersonates an LLM provider, serves scripted responses, and records every request it receives as JSONL.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "llmdouble": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "fixtures": "tsc -p tsconfig.json && node dist/fixtures/prune.js"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "@types/node": "^22.20.2",
    "ai": "6.0.168",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
